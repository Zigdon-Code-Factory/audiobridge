#include <windows.h>
#include "../../common/app_version.h"
1 VERSIONINFO
FILEVERSION AUDIOBRIDGE_VERSION_PARTS
PRODUCTVERSION AUDIOBRIDGE_VERSION_PARTS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AudioBridge"
            VALUE "FileVersion", AUDIOBRIDGE_VERSION
            VALUE "ProductName", "AudioBridge"
            VALUE "ProductVersion", AUDIOBRIDGE_VERSION
            VALUE "OriginalFilename", "audiobridge.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
