[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = audiobridge_vad.cat
DriverVer   = 10/29/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
audiobridge_vad.sys = 1

[DestinationDirs]
DefaultDestDir = 12 ; %SystemRoot%\System32\drivers

[Manufacturer]
%MfgName% = AudioBridgeMfg,NTamd64

[AudioBridgeMfg.NTamd64]
%DeviceDesc% = AudioBridgeVAD_Install, Root\AudioBridgeVAD

[AudioBridgeVAD_Install.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = AudioBridgeVAD_CopyFiles
AddReg    = AudioBridgeVAD_AddReg

[AudioBridgeVAD_CopyFiles]
audiobridge_vad.sys

[AudioBridgeVAD_AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,audiobridge_vad.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[AudioBridgeVAD_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     AudioBridgeVAD.I.Wave
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Wave%,     AudioBridgeVAD.I.Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     AudioBridgeVAD.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, AudioBridgeVAD.I.Topo
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, AudioBridgeVAD.I.Topo

[AudioBridgeVAD.I.Wave]
AddReg = AudioBridgeVAD.I.Wave.AddReg

[AudioBridgeVAD.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveFriendlyName%

[AudioBridgeVAD.I.Topo]
AddReg = AudioBridgeVAD.I.Topo.AddReg

[AudioBridgeVAD.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceDesc%

[AudioBridgeVAD_Install.NT.Services]
AddService = AudioBridgeVAD, 0x00000002, AudioBridgeVAD_Service_Inst

[AudioBridgeVAD_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\audiobridge_vad.sys

[Strings]
ProviderName       = "AudioBridge"
MfgName            = "AudioBridge"
DiskName           = "AudioBridge Virtual Audio Installation Media"
DeviceDesc         = "AudioBridge Virtual Speakers"
WaveFriendlyName   = "AudioBridge Ultra-Low-Latency WaveRT"
ServiceDesc        = "AudioBridge Ultra-Low-Latency Virtual Speaker Driver"
Proxy.CLSID        = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO   = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER  = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME= "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY= "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNAME_Wave        = "Wave"
KSNAME_Topology    = "Topology"
